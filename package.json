{
  "name": "@thomaswawra/artistlens",
  "version": "0.4.12",
  "description": "ArtistLens - A powerful Spotify Web API integration for accessing music, artists, albums, and recommendations",
  "type": "module",
  "bin": {
    "artistlens": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && mkdir -p build/static && cp src/static/favicon.png build/static/favicon.png && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "dev": "bun src/index.ts",
    "dev:http": "bun src/http-server.ts",
    "mcp": "bun build/index.js",
    "mcp:http": "bun build/http-server.js",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:http": "bun test src/__tests__/http-transport.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.6.0",
    "axios": "^1.7.9",
    "pino": "^9.11.0",
    "pino-pretty": "^13.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.24",
    "eventsource": "^4.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "mcp",
    "spotify",
    "music",
    "api",
    "modelcontextprotocol",
    "artistlens"
  ],
  "author": "Thomas Wawra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/superseoworld/artistlens.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "src/index.ts",
  "private": true
}
