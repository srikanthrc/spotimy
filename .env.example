# Spotify API Configuration
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Server Configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=3001

# Ngrok Configuration (optional but recommended)
# Get your auth token from https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTH_TOKEN=your_ngrok_auth_token_here

# Optional: Use a custom ngrok domain (requires paid ngrok plan)
# NGROK_DOMAIN=your-custom-domain.ngrok.dev
# Application Identity (for OAuth consent screen)
# Set these to customize the OAuth consent screen branding
# APP_DOMAIN=dreamer.com
# APP_NAME=Dreamer

# Turso Database (Cloudflare deployment only)
# For persistent storage across Cloudflare container restarts
# Local/Docker deployments use local SQLite files automatically
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token
